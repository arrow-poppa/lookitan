{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window and lookup popup",
  "windows": ["main", "popup", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "http://*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
