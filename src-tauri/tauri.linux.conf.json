{
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "resources": {
      "resources/ort/libonnxruntime.so": "ort/libonnxruntime.so",
      "resources/models/*": "models/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "libxcb-randr0",
          "libgbm1",
          "libegl1",
          "libvulkan1"
        ],
        "desktopTemplate": "linux/lookitan.desktop"
      },
      "rpm": {
        "depends": [
          "pipewire-libs",
          "libxcb",
          "mesa-libgbm",
          "mesa-libEGL",
          "vulkan-loader"
        ],
        "desktopTemplate": "linux/lookitan.desktop"
      }
    }
  }
}
