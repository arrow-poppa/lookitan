{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lookitan",
  "mainBinaryName": "lookitan",
  "version": "0.1.2",
  "identifier": "io.github.arrowpoppa.lookitan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lookitan",
        "url": "index.html",
        "width": 940,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Lookitan Overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "popup",
        "create": false,
        "title": "Lookitan",
        "url": "popup.html",
        "width": 580,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "shortDescription": "OCR pop-up dictionary",
    "longDescription": "Point at a word anywhere on screen, press a shortcut and get dictionary entries and an AI explanation in a pop-up. Local PP-OCRv6 OCR on the GPU, MDict dictionaries, and your own AI provider and model.",
    "license": "GPL-3.0-only",
    "copyright": "Copyright (C) 2026 arrow-poppa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
